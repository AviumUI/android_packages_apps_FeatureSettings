<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/category_system">

    <PreferenceCategory android:title="@string/system_group_spoof">
        <SwitchPreferenceCompat
            android:key="fake_bl_unlock"
            android:title="@string/fake_bl_unlock_title"
            android:summary="@string/fake_bl_unlock_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="vbmeta_update"
            android:title="@string/vbmeta_update_title"
            android:summary="@string/vbmeta_update_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="pi_enable_spoof"
            android:title="@string/pi_enable_spoof_title"
            android:summary="@string/pi_enable_spoof_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="pi_gms_cert_chain"
            android:title="@string/pi_gms_cert_chain_title"
            android:summary="@string/pi_gms_cert_chain_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="pi_games_spoof"
            android:title="@string/pi_games_spoof_title"
            android:summary="@string/pi_games_spoof_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="pi_photos_spoof"
            android:title="@string/pi_photos_spoof_title"
            android:summary="@string/pi_photos_spoof_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="pi_netflix_spoof"
            android:title="@string/pi_netflix_spoof_title"
            android:summary="@string/pi_netflix_spoof_summary"
            android:defaultValue="false" />

        <Preference
            android:key="keybox_data_load"
            android:title="@string/keybox_data_title"
            android:summary="@string/keybox_data_summary" />

        <Preference
            android:key="keybox_data_clear"
            android:title="@string/keybox_data_clear_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/system_group_misc">
        <SwitchPreferenceCompat
            android:key="force_screenshot"
            android:title="@string/force_screenshot_title"
            android:summary="@string/force_screenshot_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="screen_ocr"
            android:title="@string/screen_ocr_title"
            android:summary="@string/screen_ocr_summary"
            android:defaultValue="false" />

        <com.android.settingslib.widget.SliderPreference
            android:key="screen_ocr_high"
            android:title="@string/screen_ocr_high_title"
            android:min="7"
            android:max="20"
            settings:showSeekBarValue="true" />
    </PreferenceCategory>

</PreferenceScreen>
